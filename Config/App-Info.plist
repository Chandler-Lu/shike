<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.chandler.shike.countdowns</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>shike</string>
			</array>
		</dict>
	</array>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>$(SHIKE_CLOUD_CONTAINER)</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>拾刻</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
	<true/>
	<key>ShikeAppGroup</key>
	<string>$(SHIKE_APP_GROUP)</string>
	<key>ShikeCloudContainer</key>
	<string>$(SHIKE_CLOUD_CONTAINER)</string>
	<key>ShikeKeychainGroup</key>
	<string>$(AppIdentifierPrefix)$(SHIKE_KEYCHAIN_SUFFIX)</string>
	<key>UIAppFonts</key>
	<array>
		<string>LXGWWenKai-Regular.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>doc.on.clipboard</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>从剪贴板导入</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.chandler.shike.import.clipboard</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>photo</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>从最近一张图片导入</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.chandler.shike.import.latest-photo</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
